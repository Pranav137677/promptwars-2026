# Google Gemini Configuration
# GEMINI_API_KEY is required for calling the Gemini API.
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=8080
ENVIRONMENT=development
RATELIMIT_DEFAULT=10 per minute

# Firebase Configuration (Optional - app fully works without it)
# Set to 'true' to enable Firebase Google Sign-In & Firestore reflection history
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=promptwars-pranav-2026
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=promptwars-pranav-2026.firebaseapp.com
